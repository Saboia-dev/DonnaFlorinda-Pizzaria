# npm install + npm run dev funcionam sem preencher este arquivo.
# Sem banco, a loja funciona em demonstração e salva o histórico no navegador.

# Persistência para operação real na Vercel — banco Cloudflare D1.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_API_TOKEN=

# Acesso ao painel /admin. Senha de pelo menos 12 caracteres.
ADMIN_PASSWORD=
# Segredo aleatório de pelo menos 32 caracteres, usado para assinar a sessão.
ADMIN_SESSION_SECRET=

# Conta comercial da pizzaria no Mercado Pago — somente no servidor.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Domínio HTTPS definitivo, sem barra final.
SITE_URL=

# Deixe false para demonstração. Ativar também em /admin > Configurações.
ENABLE_LIVE_ORDERS=false
